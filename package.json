{
  "name": "healthyweb-worker",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --remote",
    "format": "eslint . --fix && prettier --write .",
    "lint": "concurrently \"eslint .\" \"prettier --check .\" \"npm run typescript\"",
    "start": "npm run dev",
    "test": "vitest",
    "types": "wrangler types",
    "typescript": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^9.39.4",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261118.1": true
  }
}
